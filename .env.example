# unifiedKnowledgeRAG lightweight provider deployment example.
# Copy to .env for local compose runs and replace placeholder secrets.

PROVIDER_API_KEY=replace-with-random-token

RAG_RETRIEVAL_BACKEND=fixture
RAG_SOURCE_DIR=/app/app/data/sources
RAG_INDEX_DIR=/app/app/data/indexes/llamaindex
RAG_SCORE_THRESHOLD=0.01

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-hash-v1
# EMBEDDING_MODEL_PATH=/models/bge-m3
# EMBEDDING_LOCAL_FILES_ONLY=true

RAG_ANSWER_COMPOSER=deterministic
RAG_ANSWER_COMPOSER_MODEL=deterministic-extractive-v1

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_chunks
QDRANT_VECTOR_NAME=text-dense
QDRANT_VECTOR_SIZE=1024
# QDRANT_API_KEY=replace-with-qdrant-token
